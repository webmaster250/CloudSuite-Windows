<Window x:Class="CloudServer.UserDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Benutzer hinzufügen" Width="470" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F6F8FB"><Border Margin="24" Padding="28" Background="White" CornerRadius="12"><StackPanel><TextBlock Text="Neuer Benutzer" FontSize="24" FontWeight="Bold" Foreground="#14375B" Margin="0,0,0,18"/><TextBlock Text="Benutzername"/><TextBox x:Name="UserBox" Height="36" Margin="0,5,0,12"/><TextBlock Text="Anzeigename"/><TextBox x:Name="NameBox" Height="36" Margin="0,5,0,12"/><TextBlock Text="Passwort"/><PasswordBox x:Name="PasswordBox" Height="36" Margin="0,5,0,12"/><TextBlock Text="Speicherkapazität"/><Grid Margin="0,5,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="QuotaBox" Text="100" Height="36"/><ComboBox x:Name="UnitBox" Grid.Column="1" Height="36" Margin="8,0,0,0" SelectedIndex="0"><ComboBoxItem Content="GB"/><ComboBoxItem Content="TB"/></ComboBox></Grid><CheckBox x:Name="UnlimitedBox" Content="Unbegrenzt / durch Speicher begrenzt" Margin="0,4,0,20"/><Button x:Name="SaveButton" Content="Benutzer anlegen" Height="44" Background="#00A9C9" Foreground="White" BorderThickness="0"/></StackPanel></Border></Window>