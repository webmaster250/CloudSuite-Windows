<Window x:Class="CloudClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="i-NET-PROMO Cloudservice" Width="1360" Height="840" MinWidth="1050" MinHeight="650" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#E5EAF0" BorderThickness="0,0,1,0"><DockPanel Margin="22,26"><StackPanel DockPanel.Dock="Top"><Image x:Name="BrandImage" Height="70" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="i-NET-PROMO" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Navy}"/><TextBlock Text="CLOUDSERVICE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Teal}" Margin="1,0,0,34"/><Button Content="☁   Meine Cloud" HorizontalContentAlignment="Left" Background="#E8F8FB"/><Button Content="▣   Persönlich" HorizontalContentAlignment="Left"/><Button Content="▤   Projekte" HorizontalContentAlignment="Left"/><Button x:Name="SharedWithMeButton" Content="↗   Mit mir geteilt" HorizontalContentAlignment="Left"/><Button x:Name="MySharesButton" Content="⚙   Meine Freigaben" HorizontalContentAlignment="Left"/><Button x:Name="TransfersNavButton" Content="⇄   Transfer" HorizontalContentAlignment="Left"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="Speicher" FontWeight="SemiBold" Foreground="{StaticResource Navy}" Margin="4,0,0,8"/><ProgressBar x:Name="StorageProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Teal}"/><TextBlock x:Name="StorageUsageText" Text="Speichernutzung wird vom Server geladen" FontSize="11" Foreground="#6C7784" Margin="4,8,0,0"/><TextBlock x:Name="SyncStatusText" Text="Sync: Vorbereitung" FontSize="11" Foreground="#6C7784" Margin="4,12,0,0"/><Button x:Name="OpenSyncFolderButton" Content="Sync-Ordner öffnen" Margin="0,8,0,0"/></StackPanel></DockPanel></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#E5EAF0" BorderThickness="0,0,0,1"><Grid Margin="28,15"><Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="42" VerticalContentAlignment="Center" FontSize="14" Padding="14,0" Text="Dateien und Ordner durchsuchen"/><Button x:Name="LogoutButton" Grid.Column="2" Content="Abmelden" Foreground="{StaticResource Navy}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="18,8"/></Grid></Border><Grid Grid.Row="1" Margin="32,28"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions><TextBlock Text="Meine Cloud" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Navy}" VerticalAlignment="Center"/><StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="←  Zurück" Margin="0,4,10,4"/><Button x:Name="NewFolderButton" Content="＋  Neuer Ordner" Background="{StaticResource Teal}" Foreground="White" BorderThickness="0" Margin="0,4,10,4"/><Button x:Name="UploadButton" Content="↑  Hochladen" Margin="0,4,10,4"/><Button x:Name="CancelUploadButton" Content="Upload abbrechen" Margin="0,4,10,4" Visibility="Collapsed"/><Button x:Name="ShareButton" Content="↗  Freigeben" Margin="0,4,10,4"/><Button x:Name="TransferButton" Content="⇄  Transfer" Margin="0,4,10,4"/><Button x:Name="DownloadButton" Content="↓  Download" Margin="0,4,10,4"/><Button x:Name="RenameButton" Content="✎  Umbenennen" Margin="0,4,10,4"/><Button x:Name="DeleteButton" Content="Löschen" Margin="0,4,10,4"/><Button x:Name="ToggleSharePermissionButton" Content="Recht umschalten" Margin="0,4,10,4" Visibility="Collapsed"/><Button x:Name="RevokeShareButton" Content="Freigabe widerrufen" Margin="0,4,10,4" Visibility="Collapsed"/><Button x:Name="CopyTransferButton" Content="Link kopieren" Margin="0,4,10,4" Visibility="Collapsed"/><Button x:Name="RevokeTransferButton" Content="Transfer widerrufen" Margin="0,4,0,4" Visibility="Collapsed"/></StackPanel><Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E1E7ED" BorderThickness="1"><DataGrid x:Name="CloudGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" FontSize="14" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Bereich" Binding="{Binding Role}" Width="180"/><DataGridTextColumn Header="Speicher" Binding="{Binding Quota}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#E9F9FC" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="↑  Dateien hierher ziehen" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Navy}"/><TextBlock Text="oder Hochladen wählen" Foreground="#6C7784" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="White" BorderBrush="#E1E7ED" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="Sicher teilen" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Navy}"/><TextBlock Text="Dateien und Ordner für Benutzer freigeben – mit Lese- oder Schreibrechten." Foreground="#6C7784" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></Grid></Grid></Grid></Grid></Window>