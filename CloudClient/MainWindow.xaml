ner durchsuchen"/><TextBlock Grid.Column="2" Text="●  Mein Konto  ▾" Foreground="{StaticResource Navy}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border><Grid Grid.Row="1" Margin="32,28"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions><TextBlock Text="Meine Cloud" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Navy}" VerticalAlignment="Center"/><StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="＋  Neuer Ordner" Background="{StaticResource Teal}" Foreground="White" BorderThickness="0" Margin="0,4,10,4"/><Button Content="↑  Hochladen" Margin="0,4,10,4"/><Button Content="↗  Freigeben" Margin="0,4,10,4"/><Button Content="⇄  Transfer"/></StackPanel><Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E1E7ED" BorderThickness="1"><DataGrid x:Name="CloudGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" FontSize="14" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Bereich" Binding="{Binding Role}" Width="180"/><DataGridTextColumn Header="Speicher" Binding="{Binding Quota}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#E9F9FC" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="↑  Dateien hierher ziehen" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Navy}"/><TextBlock Text="oder Hochladen wählen" Foreground="#6C7784" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="White" BorderBrush="#E1E7ED" BorderThickness="1" CornerRadiu